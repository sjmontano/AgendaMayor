<mxfile host="Agenda Mayor" type="device"><diagram id="02-contenedores" name="02-contenedores"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1400" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:22px;color:#1B4F8A&quot;&gt;Diagrama de contenedores — Agenda Mayor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B6B6B&quot;&gt;Nivel 2 C4 · Aplicaciones y almacenes de datos que forman el sistema y cómo se comunican&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1740" height="60" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="530.0" y="100" width="60" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Visitante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Explora proyectos, eventos y perfiles sin cuenta.&lt;/font&gt;" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;spacing=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="440" y="156" width="240" height="104" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="870.0" y="100" width="60" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Usuario registrado&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Estudiante, docente o administrador con cuenta @unimayor.edu.co.&lt;/font&gt;" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;spacing=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="780" y="156" width="240" height="104" as="geometry"/></mxCell><mxCell id="c8" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Agenda Mayor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#1168BD;strokeWidth=1.5;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="280" y="320" width="900" height="900" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Aplicación web (cliente)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: React 19 en el navegador]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Formularios, carrito de entradas, campana de notificaciones y panel interactivo (Client Components).&lt;/font&gt;" style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingTop=20;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="460" y="400" width="540" height="150" as="geometry"/></mxCell><mxCell id="c10" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Aplicación Next.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: Next.js 16 · Node.js en Vercel]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Renderiza las páginas en el servidor (Server Components) y expone la API REST /api/*. Contiene el Modelo por capas: services, repositories y DTO.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="460" y="700" width="540" height="170" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: PostgreSQL · Neon]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Usuarios y roles, proyectos, eventos, puestos, órdenes, entradas, notificaciones y pagos.&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacing=10;spacingTop=8;shadow=1;" vertex="1" parent="1"><mxGeometry x="530" y="1000" width="400" height="150" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font color=&quot;#E8890C&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Bold&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema de software externo]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Pasarela de pagos: crea links de pago, cobra y envía webhooks con el resultado.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8890C;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="1380" y="700" width="340" height="170" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font color=&quot;#C62828&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Portal UNIMAYOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema de software externo]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;unimayor.edu.co: publica el feed RSS de eventos institucionales.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="1380" y="1005" width="340" height="140" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Navega por la vitrina&lt;br&gt;y la cartelera con&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1852;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="c9"><mxGeometry x="-0.62" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Publica, compra entradas&lt;br&gt;y modera con&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8148;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c9"><mxGeometry x="-0.62" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Solicita páginas y llama a la API REST de&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[HTML · JSON / HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Lee y escribe en&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[Prisma ORM · SQL / TLS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c10" target="c11"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Crea links de pago y&lt;br&gt;consulta su estado en&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[JSON / HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1.0;exitY=0.2353;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.2353;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry x="0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Envía el webhook del pago&lt;br&gt;(SALE_APPROVED / REJECTED) a&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[JSON / HTTPS · firma HMAC]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.0;exitY=0.7647;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.7647;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c12" target="c10"><mxGeometry x="-0.45" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Lee eventos del portal desde&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[RSS / HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.9259;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c10" target="c13"><mxGeometry x="0.7" relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="1075"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Paga sus entradas en&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[Checkout de Bold · HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c12"><mxGeometry x="-0.3" relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="208"/></Array></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Despliegue&lt;/b&gt;&lt;br&gt;• Next.js corre en Vercel (funciones Node.js).&lt;br&gt;• PostgreSQL gestionado en Neon.&lt;br&gt;• Server Components consultan el Modelo directamente; los Client Components usan /api/* con fetch." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1380" y="1200" width="340" height="110" as="geometry"/></mxCell><mxCell id="c23" value="" style="rounded=1;arcSize=4;fillColor=#FAFAFA;strokeColor=#D0D0D0;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="958" height="104" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&quot;font-size:11px;color:#1B4F8A&quot;&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="1256" width="120" height="20" as="geometry"/></mxCell><mxCell id="c25" value="&lt;font color=&quot;#2E7D32&quot; style=&quot;font-size:10px&quot;&gt;Persona&lt;/font&gt;" style="rounded=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="52" y="1282" width="120" height="60" as="geometry"/></mxCell><mxCell id="c26" value="&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:10px&quot;&gt;Contenedor: app en navegador&lt;/font&gt;" style="shape=mxgraph.c4.webBrowserContainer2;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingTop=14;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="184" y="1282" width="120" height="60" as="geometry"/></mxCell><mxCell id="c27" value="&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:10px&quot;&gt;Contenedor: app servidor&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="316" y="1282" width="120" height="60" as="geometry"/></mxCell><mxCell id="c28" value="&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:10px&quot;&gt;Contenedor: base de datos&lt;/font&gt;" style="shape=cylinder3;size=8;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="448" y="1282" width="120" height="60" as="geometry"/></mxCell><mxCell id="c29" value="&lt;font color=&quot;#E8890C&quot; style=&quot;font-size:10px&quot;&gt;Sistema externo&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#E8890C;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="1282" width="120" height="60" as="geometry"/></mxCell><mxCell id="c30" value="&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:10px&quot;&gt;Límite del sistema&lt;/font&gt;" style="rounded=1;arcSize=4;fillColor=#EEF5FC;strokeColor=#1168BD;strokeWidth=1.5;dashed=1;dashPattern=8 4;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="712" y="1282" width="120" height="60" as="geometry"/></mxCell><mxCell id="c31" value="" style="endArrow=block;endFill=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#6B6B6B;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="854" y="1300" as="sourcePoint"/><mxPoint x="974" y="1300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;span style=&quot;font-size:10px&quot;&gt;Relación [tecnología]&lt;/span&gt;" style="text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="844" y="1306" width="140" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>