        </mxCell>
        <mxCell id="c14" parent="1" style="shape=component;align=center;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingLeft=16;spacing=6;jettyWidth=14;jettyHeight=8;shadow=1;" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Puestos EAFI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: service · repository · dto]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Mesas de la feria: crear, asignar a un proyecto y liberar.&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="230" x="1155" y="640" as="geometry" />
        </mxCell>
        <mxCell id="c15" parent="1" style="shape=component;align=center;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingLeft=16;spacing=6;jettyWidth=14;jettyHeight=8;shadow=1;" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Notificaciones&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: repository]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Avisa al autor (aval / rechazo) y al comprador (pago confirmado).&lt;/font&gt;" vertex="1">
