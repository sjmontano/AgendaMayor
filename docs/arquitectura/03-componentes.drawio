        <mxCell id="c10" parent="1" style="shape=component;align=center;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingLeft=16;spacing=6;jettyWidth=14;jettyHeight=8;shadow=1;" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Proyectos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: service · repository · state]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Publicar, avalar o rechazar. State: BORRADOR → EN_REVISION → PUBLICADO | RECHAZADO.&lt;/font&gt;" vertex="1">
