        <mxCell id="c3" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;b style=&quot;font-size:22px;color:#1B4F8A&quot;&gt;Diagrama de componentes — Aplicación Next.js (Agenda Mayor)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B6B6B&quot;&gt;Nivel 3 C4 · Componentes del contenedor Next.js por capas MVC: Presentación (Vista y Controlador) → Modelo → Datos e integraciones&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="2040" x="40" y="22" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#1168BD;strokeWidth=1.5;dashed=1;dashPattern=8 4;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=8;spacingTop=6;" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Aplicación Next.js&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Contenedor: Next.js 16 · Node.js]&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="1034" width="1690" x="10" y="86" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="1" style="shape=component;align=center;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingLeft=16;spacing=6;jettyWidth=14;jettyHeight=8;shadow=1;" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Páginas&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: Server Components (app/*)]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Inicio, vitrina, cartelera, detalle de evento, panel por rol, mis entradas.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="210" x="110" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="1" style="shape=component;align=center;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingLeft=16;spacing=6;jettyWidth=14;jettyHeight=8;shadow=1;" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Seguridad&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: auth.ts · sesion.ts · password.ts]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Sesión JWT en cookie httpOnly, bcrypt, requiereRol().&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="230" x="440" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="shape=component;align=center;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;spacingLeft=16;spacing=6;jettyWidth=14;jettyHeight=8;shadow=1;" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:12px&quot;&gt;Controladores REST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Componente: Route Handlers (app/api/*)]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;sesión → rol → DTO.parse() → service → ok() / err(). Incluye el webhook /api/pagos/bold/webhook.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="270" x="800" y="360" as="geometry" />
        </mxCell>
        <mxCell id="c9" parent="1" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EEF7EE;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;dashPattern=8 4;align=left;verticalAlign=top;spacingLeft=12;spacingBottom=8;spacingTop=6;" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Modelo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Capa: services · repositories · DTO]&lt;/span&gt;&lt;/font&gt;" vertex="1">
