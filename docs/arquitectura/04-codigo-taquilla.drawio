tDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c16" target="c17"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Flujo de compra&lt;/b&gt;&lt;br&gt;1. POST /api/ordenes → crearOrden(): valida CompraDTO y crea la orden PENDIENTE con código ORD-….&lt;br&gt;2. POST /api/ordenes/[codigo]/pago → iniciarPago(): crearLinkDePago() en Bold y guarda la referencia.&lt;br&gt;3. El comprador paga en Bold; Bold llama al webhook.&lt;br&gt;4. Webhook → verificarFirma() → conciliar(): consultarPago(); si es PAGADA, confirmarPago() emite las entradas ENT-… y notifica.&lt;br&gt;5. Si es RECHAZADA o EXPIRADA, cerrarOrden() la marca así y no emite entradas." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1420" y="780" width="440" height="190" as="geometry"/></mxCell><mxCell id="c34" value="" style="rounded=1;arcSize=4;fillColor=#FAFAFA;strokeColor=#D0D0D0;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="958" height="104" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b style=&quot;font-size:11px;color:#1B4F8A&quot;&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="1306" width="120" height="20" as="geometry"/></mxCell><mxCell id="c36" value="&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:10px&quot;&gt;Módulo / clase&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=1.5;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="1332" width="120" height="60" as="geometry"/></mxCell><mxCell id="c37" value="&lt;font color=&quot;#6A1B9A&quot; style=&quot;font-size:10px&quot;&gt;Tipo o DTO&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#6A1B9A;strokeWidth=1.5;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="204" y="1332" width="120" height="60" as="geometry"/></mxCell><mxCell id="c38" value="&lt;font color=&quot;#E8890C&quot; style=&quot;font-size:10px&quot;&gt;Adaptador externo&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#E8890C;strokeWidth=1.5;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="336" y="1332" width="120" height="60" as="geometry"/></mxCell><mxCell id="c39" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size:10px&quot;&gt;Punto de entrada HTTP&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#6B6B6B;strokeWidth=1.5;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="468" y="1332" width="120" height="60" as="geometry"/></mxCell><mxCell id="c40" value="&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:10px&quot;&gt;Base de datos&lt;/font&gt;" style="shape=cylinder3;size=8;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="1332" width="120" height="60" as="geometry"/></mxCell><mxCell id="c41" value="&lt;font color=&quot;#8A6D00&quot; style=&quot;font-size:10px&quot;&gt;Nota&lt;/font&gt;" style="shape=note;size=10;fillColor=#FFF8D6;strokeColor=#D6B656;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="732" y="1332" width="120" height="60" as="geometry"/></mxCell><mxCell id="c42" value="" style="endArrow=block;endFill=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#6B6B6B;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="874" y="1350" as="sourcePoint"/><mxPoint x="994" y="1350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="&lt;span style=&quot;font-size:10px&quot;&gt;Dependencia / llamada&lt;/span&gt;" style="text;html=1;align=center;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="864" y="1356" width="140" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>