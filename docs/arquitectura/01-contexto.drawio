<mxfile host="Agenda Mayor" type="device"><diagram id="01-contexto" name="01-contexto"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1120" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b style=&quot;font-size:22px;color:#1B4F8A&quot;&gt;Diagrama de contexto del sistema — Agenda Mayor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B6B6B&quot;&gt;Nivel 1 C4 · Quién usa Agenda Mayor y con qué sistemas externos se comunica&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="1860" height="60" as="geometry"/></mxCell><mxCell id="c4" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="150.0" y="100" width="60" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Visitante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Sin cuenta. Explora la vitrina de proyectos, la cartelera de eventos y los perfiles públicos.&lt;/font&gt;" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;spacing=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="240" height="104" as="geometry"/></mxCell><mxCell id="c6" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="490.0" y="100" width="60" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Administrador&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Modera todas las facultades, crea eventos oficiales, importa el portal y gestiona puestos EAFI.&lt;/font&gt;" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;spacing=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="400" y="156" width="240" height="104" as="geometry"/></mxCell><mxCell id="c8" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="830.0" y="100" width="60" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Docente&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Avala los proyectos de su facultad, crea eventos EAFI y valida entradas en la puerta.&lt;/font&gt;" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;spacing=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="740" y="156" width="240" height="104" as="geometry"/></mxCell><mxCell id="c10" value="" style="ellipse;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1170.0" y="100" width="60" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font color=&quot;#2E7D32&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Estudiante&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Persona]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Cuenta @unimayor.edu.co. Publica proyectos, crea eventos de comunidad y compra entradas.&lt;/font&gt;" style="rounded=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;spacing=8;spacingTop=6;shadow=1;" vertex="1" parent="1"><mxGeometry x="1080" y="156" width="240" height="104" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font color=&quot;#1168BD&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Agenda Mayor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema de software]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Vitrina de proyectos y cartelera de eventos de UNIMAYOR. Permite publicar y avalar proyectos, crear eventos y vender entradas.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="1260" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;font color=&quot;#E8890C&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Bold&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema de software externo]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Pasarela de pagos colombiana. Cobra con tarjeta, PSE, Nequi y Botón Bancolombia mediante links de pago.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E8890C;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="1580" y="470" width="320" height="150" as="geometry"/></mxCell><mxCell id="c14" value="&lt;font color=&quot;#C62828&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Portal UNIMAYOR&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;[Sistema de software externo]&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#333333&quot; style=&quot;font-size:10px&quot;&gt;&lt;br&gt;Sitio institucional unimayor.edu.co. Publica eventos y noticias en un feed RSS.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="320" height="140" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Consulta proyectos, eventos&lt;br&gt;y perfiles usando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0952;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c5" target="c12"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Modera, crea eventos oficiales&lt;br&gt;y gestiona puestos usando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3651;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c7" target="c12"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Avala proyectos, crea eventos EAFI&lt;br&gt;y valida entradas usando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6349;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c9" target="c12"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;Publica proyectos, crea eventos&lt;br&gt;y compra entradas usando&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.9048;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c12"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Paga sus entradas en&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[Checkout de Bold · HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry x="-0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="1740" y="208"/></Array></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Crea links de pago y&lt;br&gt;consulta su estado en&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[JSON / HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=1.0;exitY=0.2667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0;entryY=0.2667;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Notifica pagos aprobados&lt;br&gt;o rechazados a&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[Webhook · JSON / HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.0;exitY=0.7667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0;entryY=0.7667;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c13" target="c12"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;Lee los eventos publicados en&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#6B6B6B&quot;&gt;[RSS / HTTPS]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;endSize=8;strokeColor=#6B6B6B;strokeWidth=1.4;fontColor=#333333;fontSize=10;labelBackgroundColor=#FFFFFF;spacing=4;exitX=0.127;exitY=1.0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry x="0.0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Notas de alcance&lt;/b&gt;&lt;br&gt;• El pago ocurre en el checkout alojado de Bold: Agenda Mayor nunca recibe datos de tarjeta.&lt;br&gt;• Solo se aceptan cuentas con correo @unimayor.edu.co; el rol (Estudiante, Docente, Administrador) define lo que cada persona puede hacer.&lt;br&gt;• Toda integración con sistemas externos se hace desde el servidor." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#FFF8D6;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=10;fontSize=10;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1440" y="790" width="460" height="140" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;arcSize=4;fillColor=#FAFAFA;strokeColor=#D0D0D0;html=1;" vertex="1" parent="1"><mxGeometry x="440" y="800" width="694" height="104" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&quot;font-size:11px;color:#1B4F8A&quot;&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="450" y="806" width="120" height="20" as="geometry"/></mxCell><mxCell id="c26" value="&lt;font color=&quot;#2E7D32&quot; style=&quot;font-size:10px&quot;&gt;Persona&lt;/font&gt;" style="rounded=1;arcSize=30;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="452" y="832" width="120" height="60" as="geometry"/></mxCell><mxCell id="c27" value="&lt;font color=&quot;#1168BD&quot; style=&quot;font-size:10px&quot;&gt;Sistema de software (este)&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1168BD;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="584" y="832" width="120" height="60" as="geometry"/></mxCell><mxCell id="c28" value="&lt;font color=&quot;#E8890C&quot; style=&quot;font-size:10px&quot;&gt;Sistema externo: pagos&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#E8890C;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="716" y="832" width="120" height="60" as="geometry"/></mxCell><mxCell id="c29" value="&lt;font color=&quot;#C62828&quot; style=&quot;font-size:10px&quot;&gt;Sistema externo: institucional&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="848" y="832" width="120" height="60" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=block;endFill=1;html=1;dashed=1;dashPattern=6 4;strokeColor=#6B6B