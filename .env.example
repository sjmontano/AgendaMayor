# ── Postgres / Neon ───────────────────────────────────────────
# Neon → Dashboard → Connection string.
#  - DATABASE_URL: cadena "Pooled" (host con "-pooler"), la usa la app.
#  - DIRECT_URL:  cadena "Direct" (sin "-pooler"), la usan las migraciones.
# Ambas terminan en ?sslmode=require
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/agendamayor?sslmode=require"
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/agendamayor?sslmode=require"

# ── Autenticación propia ──────────────────────────────────────
# Cadena larga y aleatoria para firmar la cookie de sesión.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres"

# ── Opcional ──────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
