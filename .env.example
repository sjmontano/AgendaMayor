# ── Postgres / Neon ───────────────────────────────────────────
# Neon → Dashboard → Connection string.
#  - DATABASE_URL: cadena "Pooled" (host con "-pooler"), la usa la app.
#  - DIRECT_URL:  cadena "Direct" (sin "-pooler"), la usan las migraciones.
# Ambas terminan en ?sslmode=require
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/agendamayor?sslmode=require"
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/agendamayor?sslmode=require"

# ── Autenticación propia ──────────────────────────────────────
# Cadena larga y aleatoria para firmar la cookie de sesión.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres"

# ── Stripe (taquilla) ─────────────────────────────────────────
# Dashboard → Developers → API keys. Usa las claves de TEST en desarrollo.
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard → Developers → Webhooks → Add endpoint:
#   https://TU-DOMINIO/api/stripe/webhook
#   Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#            checkout.session.async_payment_failed, checkout.session.expired,
#            charge.refunded
# En local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# y pega aquí el whsec_... que imprime el CLI.
STRIPE_WEBHOOK_SECRET="whsec_..."
# COP es la moneda de la taquilla. Stripe cobra en unidades menores (centavos).
STRIPE_CURRENCY="cop"

# ── Opcional ──────────────────────────────────────────────────
# URL pública para construir success_url/cancel_url de Stripe.
# NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app
# Si se activa, los eventos pagos de estudiantes se envían a revisión.
# EVENTOS_REQUIEREN_APROBACION=true
