<mxCell id="n_taquilla" value="&lt;b&gt;Reserva atómica&lt;/b&gt; (taquilla.repository.ts): UPDATE ... WHERE cantidad_vendida + cantidad_reservada + n ≤ cantidad_total. Si no hay cupo → 409. El precio y el total salen de TipoEntrada, nunca del cliente. Límite: 8 órdenes por correo/IP en 10 min." style="fontFamily=Helvetica;html=1;shape=note;whiteSpace=wrap;size=12;fillColor=#FFF8D6;strokeColor=#B8A04A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="1700" width="290" height="180" as="geometry"/></mxCell>
<mxCell id="n_pago" value="&lt;b&gt;Máquina de estados&lt;/b&gt; (orden.state.ts): PENDIENTE → PAGADA | EXPIRADA | FALLIDA | CANCELADA; PAGADA → REEMBOLSADA. El webhook es idempotente (stripe_evento.stripe_event_id único) y emite las entradas una sola vez." style="fontFamily=Helvetica;html=1;shape=note;whiteSpace=wrap;size=12;fillColor=#FFF8D6;strokeColor=#B8A04A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="1900" width="290" height="150" as="geometry"/></mxCell>
<mxCell id="n_entrada" value="El &lt;b&gt;código&lt;/b&gt; de la entrada es el QR. validarEntrada hace VALIDA → USADA en una operación condicional. El reembolso total anula las entradas y devuelve el cupo; un evento CANCELADO bloquea compra y validación." style="fontFamily=Helvetica;html=1;shape=note;whiteSpace=wrap;size=12;fillColor=#FFF8D6;strokeColor=#B8A04A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="2070" width="290" height="170" as="geometry"/></mxCell>
<mxCell id="n_asist" value="&lt;b&gt;Relaciones con Usuario:&lt;/b&gt; 1—0..* Orden (comprador); 1—0..* Entrada (asistente) y 1—0..* Entrada validada (organizador o ADMIN)." style="fontFamily=Helvetica;html=1;shape=note;whiteSpace=wrap;size=12;fillColor=#FFF8D6;strokeColor=#B8A04A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1790" y="2260" width="290" height="110" as="geometry"/></mxCell>
