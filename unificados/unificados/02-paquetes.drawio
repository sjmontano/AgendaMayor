<mxCell id="d_taquilla_txt" value="La taquilla vive en su propio paquete:&lt;br&gt;• reserva atómica de cupo + orden PENDIENTE&lt;br&gt;• sesión de Stripe Checkout (monto desde TipoEntrada)&lt;br&gt;• webhook idempotente → PAGADA + entradas&lt;br&gt;• validación en puerta y reembolso total&lt;br&gt;&lt;br&gt;&lt;i&gt;POST /api/checkout · /api/stripe/webhook&lt;br&gt;/api/entradas/validar · /api/ordenes/[codigo]/reembolso&lt;/i&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;text;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontStyle=0;" vertex="1" parent="mod"><mxGeometry x="310.0" y="444.0" width="560.0" height="200.0" as="geometry"/></mxCell>
