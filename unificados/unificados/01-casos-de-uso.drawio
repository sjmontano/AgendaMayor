<mxCell id="n_est" value="&lt;b&gt;proyecto.state.ts&lt;/b&gt;&lt;br&gt;BORRADOR → EN_REVISION&lt;br&gt;EN_REVISION → PUBLICADO | RECHAZADO (Docente)&lt;br&gt;RECHAZADO → EN_REVISION (Estudiante)&lt;br&gt;BORRADOR · RECHAZADO · PUBLICADO → ELIMINADO" style="fontFamily=Helvetica;shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8D6;strokeColor=#B8A04A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080.0" y="1219.4" width="310.0" height="100.0" as="geometry"/></mxCell>
